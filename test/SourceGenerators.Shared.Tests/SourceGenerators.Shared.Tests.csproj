<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>10.0</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<UseAppHost>true</UseAppHost>
		<RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
		<PackageReference Include="xunit.v3" Version="4.0.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
	</ItemGroup>

	<ItemGroup>
		<!-- 直接把源码包的 Source 目录编进测试程序集，验证 internal 在消费方程序集内可用 -->
		<Compile Include="..\..\src\SourceGenerators.Shared\Source\**\*.cs"
		         Link="SourceGenerators.Shared\%(RecursiveDir)%(Filename)%(Extension)" />
		<!-- 把同一批源码作为资源嵌入，供消费方编译兼容性测试按原始文本重新编译 -->
		<EmbeddedResource Include="..\..\src\SourceGenerators.Shared\Source\**\*.cs"
		                  LogicalName="Injected.%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
