<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>10.0</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>true</IsPackable>
		<PackageId>SourceGenerators.Shared</PackageId>
		<Title>SourceGenerators.Shared</Title>
		<Description>源生成器共享源码包</Description>
		<PackageTags>source-generators;roslyn;generator;infrastructure</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>何镇汐</Authors>
		<DevelopmentDependency>true</DevelopmentDependency>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/util-core/SourceGenerators.Shared</RepositoryUrl>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="Source\**\*.cs" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Source\**\*.cs" Pack="true" PackagePath="Source/" />
		<None Include="buildTransitive\SourceGenerators.Shared.props" Pack="true" PackagePath="buildTransitive" />
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\README.en.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
